<launch>
    <node pkg="solve" type="voice.py" name="voice" output="screen" />
    
    <node pkg="solve" type="vision.py" name="vision" output="screen" />

    <node pkg="solve" type="move.py" name="move" output="screen" />
  
    <node pkg="solve" type="master.py" name="master" output="screen" />
    <rosparam param="/master/task_num">6</rosparam>
</launch>